# Set these locally in .env.local for database commands and Docker Compose.
# Keep credentials server-side; never prefix these keys with NEXT_PUBLIC_.
DATABASE_URL=
POSTGRES_PASSWORD=

# Set this in .env.test.local (or the shell) for database integration tests.
# It must point to a PostgreSQL maintenance database with CREATEDB permission.
TEST_DATABASE_URL=

# Single-password authentication. Generate these locally; never commit values.
APP_PASSWORD_HASH=
SESSION_SECRET=
